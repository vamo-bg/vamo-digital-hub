# Правила за сървъра на vamo.bg (LiteSpeed, съвместим с Apache).
#
# Файлът е част от билда: стои в `public/`, влиза в `dist/` и се качва при
# всеки деплой. Промени, направени директно на сървъра, ще бъдат презаписани —
# редактирай тук.
#
# cPanel Force HTTPS Redirect е включен на ниво сървър. За да може заявките
# към http://www.vamo.bg да стигат директно до основния адрес, изключете го
# в cPanel след публикуване на тези правила. .htaccess поема и двете версии.

# ---------------------------------------------------------------------------
# Един адрес за сайта
# ---------------------------------------------------------------------------
# Двете правила пращат www и незащитения основен адрес направо към
# https://vamo.bg, със запазване на пътя и параметрите на заявката.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.vamo\.bg$ [NC]
  RewriteRule ^ https://vamo.bg%{REQUEST_URI} [R=301,L,NE]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^vamo\.bg$ [NC]
  RewriteRule ^ https://vamo.bg%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# ---------------------------------------------------------------------------
# Собствена страница при липсващ адрес
# ---------------------------------------------------------------------------
# Без това сървърът показва своята сива страница „404 Not Found" — без меню и
# без изход към сайта. Astro билдва наша, с навигацията и дизайна.
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Кеширане
# ---------------------------------------------------------------------------
# Файловете в /assets/ носят отпечатък от съдържанието си в името: смени ли се
# съдържанието, сменя се и адресът. Затова могат да се кешират безсрочно —
# браузърът никога няма да покаже стара версия. `immutable` му казва да не
# проверява дори при презареждане.
#
# Шрифтовете в /fonts/ имат постоянни имена, но се сменят веднъж на няколко
# години. Ако потрябва, името им се сменя ръчно.
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/(assets|fonts)/" LONG_CACHE=1
</IfModule>

<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=LONG_CACHE

  # HTML нарочно остава без дълъг кеш — съдържанието се променя и посетителят
  # трябва да вижда текущата версия.
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # HTTPS вече е каноничният адрес. Не включваме поддомейните, защото други
  # проекти на VAMO се обслужват отделно и не са одитирани за HSTS.
  Header always set Strict-Transport-Security "max-age=15552000"

  # Базова прилагана CSP. Ограниченията за скриптове и стилове изискват отделен
  # одит на GTM и вградените Astro скриптове, преди да бъдат наложени.
  Header always set Content-Security-Policy "object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
</IfModule>

# ---------------------------------------------------------------------------
# Кирилица в текстовите файлове
# ---------------------------------------------------------------------------
# .txt файловете (llms.txt) тръгват без charset в Content-Type. Браузърът и AI
# ботовете гадаят кодировка и показват кирилицата като йероглифи. И `AddCharset`,
# и `AddType` минават през mod_mime — а то не се разпознава на този сървър
# (проверено на живо: и двете паднаха тихо). `Header set` през mod_headers
# работи тук, затова заобикаля MIME регистрацията и налага заглавието direct.
<IfModule mod_headers.c>
  <FilesMatch "\.txt$">
    Header set Content-Type "text/plain; charset=UTF-8"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# Запитванията не са публични
# ---------------------------------------------------------------------------
# `kontakt.php` записва запитванията извън webroot-а. Ако сървърът не му позволи
# да пише там, минава на резервна папка `.private` вътре в сайта — и тогава този
# правилото по-долу я държи скрита. Съдържа лични данни. <DirectoryMatch>
# не е позволен в .htaccess и пречи на cPanel да редактира пренасочванията.
RedirectMatch 404 /\.private(/.*)?$

# ---------------------------------------------------------------------------
# Компресия
# ---------------------------------------------------------------------------
# Сървърът вече компресира с brotli. Тук е само за типовете, които понякога
# остават извън списъка му по подразбиране.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
