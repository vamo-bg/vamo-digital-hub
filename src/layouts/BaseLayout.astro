---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ConsentBanner from '../components/layout/ConsentBanner.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  canonical?: URL | string;
  image?: URL | string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url,
  image,
  noindex = false,
} = Astro.props;

const siteName = import.meta.env.PUBLIC_SITE_NAME ?? site.name;
const pageTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonicalUrl = new URL(canonical, Astro.site ?? Astro.url);
const socialImageUrl = image ? new URL(image, Astro.site ?? Astro.url) : undefined;
const hasHeader = Astro.slots.has('header');
const hasFooter = Astro.slots.has('footer');
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.legalName,
  url: new URL('/', Astro.site ?? Astro.url).href,
  logo: new URL('/favicon-192.png', Astro.site ?? Astro.url).href,
  description: site.description,
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+359899180790',
    email: 'office@vamo.bg',
    contactType: 'customer support',
    availableLanguage: 'Bulgarian',
  },
};
---

<!doctype html>
<html lang="bg">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    {/*
      Consent Mode v2. Трябва да се изпълни преди Tag Manager, иначе тагове
      могат да се задействат, преди да е обявено, че съгласие няма.
      Всичко по избор е `denied`; ако посетителят вече е избрал, изборът се
      възстановява веднага, за да не се чака повторно решение.
    */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500,
      });
      gtag('set', 'ads_data_redaction', true);
      gtag('set', 'url_passthrough', true);

      try {
        var vamoConsent = localStorage.getItem('vamo-consent');
        if (vamoConsent) {
          var parsed = JSON.parse(vamoConsent);
          if (parsed && parsed.state) gtag('consent', 'update', parsed.state);
        }
      } catch (error) {
        /* Частен режим или блокирано хранилище: оставаме на `denied`. */
      }
    </script>

    <script is:inline define:vars={{ gtmId: site.analytics.gtmId }}>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', gtmId);
    </script>

    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=PT+Sans:wght@400;700&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="bg_BG" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}

    <meta name="twitter:card" content={socialImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}

    <title>{pageTitle}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />
    <slot name="head" />
  </head>
  <body>
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${site.analytics.gtmId}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"></iframe>
    </noscript>

    <a class="skip-link" href="#main-content">Към основното съдържание</a>
    <header class="page-header">
      {hasHeader ? <slot name="header" /> : <Header />}
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer>
      {hasFooter ? <slot name="footer" /> : <Footer />}
    </footer>

    <ConsentBanner />
  </body>
</html>

<style>
  .page-header {
    min-height: 3.5rem;
  }

  .skip-link {
    position: fixed;
    inset-block-start: 0;
    inset-inline-start: 0;
    z-index: 9999;
    padding: var(--space-3) var(--space-4);
    background: var(--color-vamo-black);
    color: var(--color-text-inverse);
    font-family: var(--font-ui);
    transform: translateY(-110%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  @media (min-width: 64rem) {
    .page-header {
      min-height: 3.5625rem;
    }
  }
</style>
