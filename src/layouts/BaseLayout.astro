---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ConsentBanner from '../components/layout/ConsentBanner.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  canonical?: URL | string;
  /**
   * Картинка за споделяне. Подай `ImageMetadata` и се изрязва на 1200×630;
   * подай низ и се ползва както е. Без нея върви общата картичка на сайта.
   */
  image?: ImageMetadata | URL | string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url,
  image,
  noindex = false,
} = Astro.props;

const siteName = import.meta.env.PUBLIC_SITE_NAME ?? site.name;
const pageTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonicalUrl = new URL(canonical, Astro.site ?? Astro.url);
/**
 * Facebook, LinkedIn и X показват 1200×630. Всичко друго го режат сами, обикновено
 * през средата на лицето или текста. Затова тук се изрязва предварително, а
 * страница без своя картинка ползва общата — празният правоъгълник при
 * споделяне изглежда по-зле от всяка картинка.
 */
/* Астро не увеличава изображения над оригинала, затова картинка, по-малка от
 * картичката, би излязла умалена. По-добре общата, отколкото размазана. */
const canMakeCard =
  image && typeof image === 'object' && 'src' in image
    ? image.width >= 1200 && image.height >= 630
    : false;

const socialImage = canMakeCard
  ? await getImage({
      src: image as ImageMetadata,
      width: 1200,
      height: 630,
      fit: 'cover',
      format: 'jpeg',
    })
  : null;

const socialImageUrl = new URL(
  socialImage?.src ?? (canMakeCard ? undefined : typeof image === 'string' || image instanceof URL ? image : undefined) ?? '/og-home.jpg',
  Astro.site ?? Astro.url,
);
const hasHeader = Astro.slots.has('header');
const hasFooter = Astro.slots.has('footer');
const siteOrigin = new URL('/', Astro.site ?? Astro.url).href;

/**
 * Записът за организацията. `@id` го прави именуван обект, към който другите
 * схеми на сайта сочат, вместо всяка да описва фирмата наново.
 *
 * `description` съединява девиза и текста, защото сам по себе си текстът
 * започва с „която“ и е изречение без начало.
 *
 * Всяко поле тук отговаря на нещо видимо на страницата — адресът и телефонът
 * стоят във футъра. Маркирането на невидимо съдържание е нарушение, не трик.
 */
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteOrigin}#organization`,
  name: site.legalName,
  alternateName: site.name,
  url: siteOrigin,
  logo: new URL('/favicon-192.png', Astro.site ?? Astro.url).href,
  description: `${site.tagline}, ${site.description}`,
  telephone: site.contact.phone.href.replace('tel:', ''),
  email: site.contact.email.href.replace('mailto:', ''),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.postalAddress.street,
    addressLocality: site.postalAddress.locality,
    addressCountry: site.postalAddress.country,
  },
  sameAs: site.socials
    .map((social) => social.url)
    .filter((url): url is string => typeof url === 'string'),
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: site.contact.phone.href.replace('tel:', ''),
    email: site.contact.email.href.replace('mailto:', ''),
    contactType: 'customer support',
    availableLanguage: 'Bulgarian',
  },
};
---

<!doctype html>
<html lang="bg">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    {/*
      Consent Mode v2. Трябва да се изпълни преди Tag Manager, иначе тагове
      могат да се задействат, преди да е обявено, че съгласие няма.
      Всичко по избор е `denied`; ако посетителят вече е избрал, изборът се
      възстановява веднага, за да не се чака повторно решение.
    */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500,
      });
      gtag('set', 'ads_data_redaction', true);
      gtag('set', 'url_passthrough', true);

      try {
        var vamoConsent = localStorage.getItem('vamo-consent');
        if (vamoConsent) {
          var parsed = JSON.parse(vamoConsent);
          if (parsed && parsed.state) gtag('consent', 'update', parsed.state);
        }
      } catch (error) {
        /* Частен режим или блокирано хранилище: оставаме на `denied`. */
      }
    </script>

    <script is:inline define:vars={{ gtmId: site.analytics.gtmId }}>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', gtmId);
    </script>

    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/*
      Шрифтовете се сервират от нашия сървър (`src/styles/fonts.css`), затова
      тук няма външни връзки. Предварително се зареждат само двата среза, които
      са нужни веднага: заглавията и основният текст на кирилица.
    */}
    <link
      rel="preload"
      href="/fonts/montserrat-700-cyrillic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/pt-sans-400-cyrillic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="bg_BG" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    <title>{pageTitle}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />
    <slot name="head" />
  </head>
  <body>
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${site.analytics.gtmId}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"></iframe>
    </noscript>

    <a class="skip-link" href="#main-content">Към основното съдържание</a>
    <header class="page-header">
      {hasHeader ? <slot name="header" /> : <Header />}
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer>
      {hasFooter ? <slot name="footer" /> : <Footer />}
    </footer>

    <ConsentBanner />
  </body>
</html>

<style>
  .page-header {
    min-height: 3.5rem;
  }

  .skip-link {
    position: fixed;
    inset-block-start: 0;
    inset-inline-start: 0;
    z-index: 9999;
    padding: var(--space-3) var(--space-4);
    background: var(--color-vamo-black);
    color: var(--color-text-inverse);
    font-family: var(--font-ui);
    transform: translateY(-110%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  @media (min-width: 64rem) {
    .page-header {
      min-height: 3.5625rem;
    }
  }
</style>
