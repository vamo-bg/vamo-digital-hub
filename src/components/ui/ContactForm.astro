---
/**
 * Формата за запитване.
 *
 * Праща към `public/kontakt.php`, който стои на същия хостинг. Защитата от
 * ботове е обяснена там; тук са само полетата, които тя изисква.
 *
 * Солта трябва да съвпада с тази в PHP файла. Разминат ли се, всяко запитване
 * се дропва тихо и никой не разбира.
 */
const SALT = 'vamo-bg-zapitvane-';
---

<form
  class="contact-form"
  id="zapitvane"
  action="/kontakt.php"
  method="POST"
  aria-describedby="contact-form-status"
>
  <p class="contact-form__error" id="contact-form-status" role="alert" hidden></p>

  <fieldset>
    <legend class="sr-only">Форма за запитване</legend>

    <div class="contact-form__grid">
      <label>
        <span>Име и организация</span>
        <input type="text" name="name" autocomplete="name" placeholder="Вашето име" required />
      </label>
      <label>
        <span>Имейл <em>(по желание)</em></span>
        <input type="email" name="email" autocomplete="email" placeholder="name@example.com" />
      </label>
      <label>
        <span>Телефон</span>
        <input type="tel" name="phone" autocomplete="tel" placeholder="Вашият телефон" required />
      </label>
      <label>
        <span>Каква е задачата?</span>
        <textarea
          name="message"
          rows="5"
          placeholder="Кратко опишете контекста и какво искате да постигнете."></textarea>
      </label>
    </div>

    {/*
      Капан за ботове. Имената нарочно не са `name`, `email` или `phone`:
      автодопълването на браузъра би ги попълнило и би блокирало реален човек.
      Скрити са извън екрана, а не с `display:none`, защото по-умните ботове
      прескачат скритите по този начин полета.
    */}
    <div class="contact-form__trap" aria-hidden="true">
      <input type="text" name="hp_fax" tabindex="-1" autocomplete="off" />
      <input type="text" name="hp_website" tabindex="-1" autocomplete="off" />
      <input type="text" name="hp_address_3" tabindex="-1" autocomplete="off" />
    </div>

    <input type="hidden" name="form_ts" value="" />
    <input type="hidden" name="form_token" value="" />
    <input type="hidden" name="source" value="" />

    <div class="contact-form__footer">
      <label class="contact-form__consent">
        <input type="checkbox" name="consent" value="1" required />
        <span>
          Съгласен/съгласна съм предоставените данни да бъдат използвани за отговор
          на запитването. <a href="/politika-za-poveritelnost/">Политика за поверителност</a>
        </span>
      </label>
      <button type="submit">Изпратете запитването</button>
    </div>
  </fieldset>
</form>

<script define:vars={{ SALT }}>
  const setUpInquiryForm = () => {
    const form = document.querySelector('.contact-form');
    if (!form || form.dataset.ready === 'true') return;
    form.dataset.ready = 'true';

    const loadedAt = Math.floor(Date.now() / 1000);
    form.querySelector('[name="form_ts"]').value = String(loadedAt);
    form.querySelector('[name="form_token"]').value = btoa(
      SALT + new Date().toISOString().split('T')[0],
    );
    form.querySelector('[name="source"]').value = location.pathname;

    // Съобщенията отговарят на кодовете, които PHP връща при човешка грешка.
    const messages = {
      consent: 'Моля, отметнете съгласието за обработка на данните.',
      required: 'Моля, попълнете име и телефон.',
      email: 'Имейл адресът изглежда невалиден.',
      length: 'Едно от полетата е твърде дълго.',
      send: 'Възникна техническа грешка. Обадете се или ни пишете директно.',
    };
    const code = new URLSearchParams(location.search).get('error');
    if (code && messages[code]) {
      const box = form.querySelector('#contact-form-status');
      box.textContent = messages[code];
      box.hidden = false;
      box.scrollIntoView({ block: 'center' });
    }

    // Изпращане под три секунди след зареждане е почти сигурно бот. Тук само
    // го спираме; сървърът го маркира за проверка, вместо да го изхвърля.
    form.addEventListener('submit', (event) => {
      if (Math.floor(Date.now() / 1000) - loadedAt < 3) {
        event.preventDefault();
      }
    });
  };

  setUpInquiryForm();
  document.addEventListener('astro:page-load', setUpInquiryForm);
</script>

<style>
  .contact-form{padding:var(--space-6);border:1px solid var(--color-border-strong);border-radius:var(--radius-surface);background:var(--color-cream)}
  .contact-form fieldset{display:grid;gap:var(--space-6);min-width:0;margin:0;padding:0;border:0}
  .contact-form__grid{display:grid;gap:var(--space-5)}
  .contact-form label:not(.contact-form__consent){display:grid;gap:var(--space-2);color:var(--color-text);font-family:var(--font-ui);font-size:.9375rem;font-weight:700;line-height:1.4}
  .contact-form label span em{color:var(--color-text-muted);font-style:normal;font-weight:400}
  .contact-form input,.contact-form textarea{width:100%;border:1px solid var(--color-border-strong);border-radius:var(--radius-control);background:var(--color-surface);color:var(--color-text);font:inherit;font-weight:400;line-height:1.5}
  .contact-form input{min-height:3rem;padding-inline:var(--space-4)}.contact-form textarea{min-height:8.5rem;padding:var(--space-3) var(--space-4);resize:vertical}
  .contact-form input::placeholder,.contact-form textarea::placeholder{color:var(--color-neutral-600);opacity:1}
  .contact-form__footer{display:grid;gap:var(--space-5);align-items:center}.contact-form__consent{display:grid;grid-template-columns:var(--space-5) minmax(0,1fr);gap:var(--space-3);align-items:start;color:var(--color-text-muted);font-size:.875rem;line-height:1.5}.contact-form__consent input{width:var(--space-5);height:var(--space-5);margin:0}.contact-form__consent a{color:var(--color-text);text-underline-offset:.2em}
  .contact-form button{min-height:3rem;justify-self:start;padding:var(--space-3) var(--space-6);border:1px solid var(--color-vamo-red);border-radius:var(--radius-control);background-color:var(--color-vamo-red) !important;color:var(--color-white) !important;font-family:var(--font-heading);font-size:.9375rem;font-weight:600;cursor:pointer;opacity:1 !important;filter:none !important;transition:background-color var(--dur-1) ease,transform var(--dur-1) var(--ease-out-quad)}.contact-form button:hover{background-color:var(--color-primary-hover) !important}.contact-form button:active{transform:translateY(1px)}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}

  /* Скрито извън екрана, не с display:none — по-умните ботове прескачат
     полетата, скрити по втория начин, и капанът не сработва. */
  .contact-form__trap{position:absolute;left:-9999px;top:-9999px;width:1px;height:1px;overflow:hidden;opacity:0;z-index:-1}

  .contact-form__error{margin-block-end:var(--space-5);padding:var(--space-3) var(--space-4);border-inline-start:3px solid var(--color-vamo-red);background:var(--color-red-50);color:var(--color-text);font-size:.9375rem;line-height:1.5}
  .contact-form__error[hidden]{display:none}

  @media(min-width:48rem){.contact-form{padding:var(--space-8)}.contact-form__grid{grid-template-columns:1fr}.contact-form__footer{grid-template-columns:1fr}.contact-form button{justify-self:start}}
</style>
