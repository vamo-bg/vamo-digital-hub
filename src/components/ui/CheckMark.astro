---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg class:list={['check-mark', className]} viewBox="0 0 20 20" aria-hidden="true" focusable="false">
  <circle cx="10" cy="10" r="10" />
  <path class="check-mark__tick" d="m5.9 10.4 2.6 2.6 5.6-5.8" />
</svg>

<style>
  .check-mark {
    flex: none;
    width: 1rem;
    height: 1rem;
    fill: var(--color-vamo-red);
  }

  .check-mark__tick {
    fill: none;
    stroke: var(--color-white);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
