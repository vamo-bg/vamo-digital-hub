---
interface Item { title: string; description: string; }
interface Props { title: string; intro: string; items: Item[]; }
const { title, intro, items } = Astro.props;
---

<section class="service-scope" aria-labelledby="service-scope-title">
  <div class="service-scope__shell">
    <header><p class="service-label">Какво включва</p><h2 id="service-scope-title">{title}</h2><p>{intro}</p></header>
    <ul>{items.map((item)=><li><h3>{item.title}</h3><p>{item.description}</p></li>)}</ul>
  </div>
</section>

<style>
  .service-scope{padding-block:var(--layout-anchor-padding-mobile);background:var(--color-vamo-black);color:var(--color-text-inverse)}
  .service-scope__shell{width:min(calc(100% - 2 * var(--layout-gutter-mobile)),var(--layout-content-max));margin-inline:auto}
  header{display:grid;max-width:48rem}
  .service-label{color:var(--color-accent-on-dark);font-family:var(--font-heading);font-size:.75rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase}
  h2{margin-block-start:var(--space-3);font-size:var(--type-section-title);font-weight:700;line-height:1.15;letter-spacing:-.02em}
  header>p:last-child{max-width:58ch;margin-block-start:var(--space-6);color:var(--color-neutral-300);font-size:1.0625rem;line-height:1.65}
  ul{display:grid;margin:var(--space-10) 0 0;padding:0;border-block-start:1px dotted var(--color-neutral-600);list-style:none}
  li{display:grid;align-content:start;padding-block:var(--space-6);border-block-end:1px dotted var(--color-neutral-600)}
  h3{display:grid;grid-template-columns:var(--space-3) minmax(0,1fr);align-items:center;gap:var(--space-3);font-size:var(--type-card-title);font-weight:600;line-height:1.3}
  h3::before{box-sizing:border-box;width:var(--space-3);height:var(--space-3);border:3px solid var(--color-vamo-black);border-radius:var(--radius-full);outline:1px solid var(--color-neutral-600);background:var(--color-accent-on-dark);content:''}
  li p{max-width:34ch;margin-block-start:var(--space-3);padding-inline-start:calc(var(--space-3) + var(--space-3));color:var(--color-neutral-300);font-size:.9375rem;line-height:1.55}
  @media(min-width:48rem){
    .service-scope{padding-block:var(--layout-anchor-padding-desktop)}
    .service-scope__shell{width:min(calc(100% - 2 * var(--layout-gutter-desktop)),var(--layout-content-max))}
    ul{grid-template-columns:repeat(3,minmax(0,1fr))}
    li{min-height:10rem;padding:var(--space-6) var(--space-8)}
    li:not(:nth-child(3n+1)){border-inline-start:1px dotted var(--color-neutral-600)}
  }
</style>
