---
interface Video {
  title: string;
  youtubeId: string;
  group: string;
  relatedLink?: { label: string; url: string };
}

interface Props {
  items: Video[];
}

const { items } = Astro.props;
const groups = [...new Set(items.map((item) => item.group))].map((title) => ({
  title,
  videos: items.filter((item) => item.group === title),
}));
---

{items.length > 0 && (
  <section class="project-videos" aria-labelledby="project-videos-title">
    <div class="project-videos__shell">
      <div class="project-videos__heading">
        <h2 id="project-videos-title">Видео от проекта</h2>
        <p>Събитията и работата по проекта, разказани във видео.</p>
      </div>
      {groups.map((group) => (
        <div class="project-videos__group">
          <h3>{group.title}</h3>
          <ul>
            {group.videos.map((video) => (
              <li>
                <div class="project-videos__player">
                  <button
                    type="button"
                    data-video-play
                    data-video-id={video.youtubeId}
                    data-video-title={video.title}
                    aria-label={`Пуснете видеото: ${video.title}`}
                  >
                    <img
                      src={`https://i.ytimg.com/vi/${video.youtubeId}/hqdefault.jpg`}
                      alt=""
                      width="480"
                      height="360"
                      loading="lazy"
                    />
                    <span class="project-videos__play" aria-hidden="true"><i class="ph ph-play"></i></span>
                    <span>Пуснете видеото</span>
                  </button>
                </div>
                <div class="project-videos__details">
                  <h4>{video.title}</h4>
                  <a href={`https://www.youtube.com/watch?v=${video.youtubeId}`} target="_blank" rel="noopener noreferrer">Гледайте в YouTube</a>
                  {video.relatedLink && <a href={video.relatedLink.url} target="_blank" rel="noopener noreferrer">{video.relatedLink.label}</a>}
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
)}

<script>
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>('[data-video-play]');
    if (!button) return;
    const id = button.dataset.videoId;
    if (!id || !/^[A-Za-z0-9_-]{11}$/.test(id)) return;

    const frame = document.createElement('iframe');
    frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
    frame.title = button.dataset.videoTitle ?? 'Видео от проекта';
    frame.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share';
    frame.allowFullscreen = true;
    frame.referrerPolicy = 'strict-origin-when-cross-origin';
    button.replaceWith(frame);
  });
</script>

<style>
  .project-videos { padding-block: var(--layout-anchor-padding-mobile); background: var(--color-neutral-100); color: var(--color-text); }
  .project-videos__shell { width: min(calc(100% - (2 * var(--layout-gutter-mobile))), var(--layout-content-max)); margin-inline: auto; }
  .project-videos__heading { display: grid; gap: var(--space-4); margin-block-end: var(--space-10); }
  .project-videos h2 { font-size: var(--type-section-title); font-weight: 600; letter-spacing: -.02em; line-height: 1.2; }
  .project-videos__heading p { max-width: 60ch; color: var(--color-text-muted); line-height: 1.65; }
  .project-videos__group + .project-videos__group { margin-block-start: var(--space-12); }
  .project-videos h3 { margin-block-end: var(--space-5); font-size: var(--type-card-title); font-weight: 600; line-height: 1.3; }
  .project-videos ul { display: grid; gap: var(--space-8); margin: 0; padding: 0; list-style: none; }
  .project-videos li { min-width: 0; }
  .project-videos__player { aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--radius-surface); background: var(--color-vamo-black); }
  .project-videos__player button, .project-videos__player :global(iframe) { display: flex; width: 100%; height: 100%; border: 0; }
  .project-videos__player button { position: relative; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-4); color: var(--color-text-inverse); font: 600 1rem/1.4 var(--font-ui); cursor: pointer; }
  .project-videos__player button::before { position: absolute; z-index: 1; inset: 0; background: color-mix(in srgb, var(--color-vamo-black) 35%, transparent); content: ''; }
  .project-videos__player button:hover::before { background: color-mix(in srgb, var(--color-vamo-black) 55%, transparent); }
  .project-videos__player button img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .project-videos__player button span { position: relative; z-index: 2; }
  .project-videos__player button:focus-visible { outline: 3px solid var(--color-focus); outline-offset: -3px; }
  .project-videos__play { display: grid; width: var(--space-16); height: var(--space-16); place-items: center; border-radius: var(--radius-full); background: var(--color-vamo-red); color: var(--color-white); font-size: 1.5rem; }
  .project-videos__details { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-3) var(--space-5); margin-block-start: var(--space-4); }
  .project-videos h4 { flex-basis: 100%; font-size: 1.125rem; font-weight: 600; line-height: 1.4; }
  .project-videos__details a { color: var(--color-text-muted); line-height: 1.5; text-underline-offset: .2em; }
  .project-videos__details a:hover { color: var(--color-vamo-red); }
  .project-videos__details a:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  @media (min-width: 48rem) {
    .project-videos { padding-block: var(--layout-anchor-padding-desktop); }
    .project-videos__shell { width: min(calc(100% - (2 * var(--layout-gutter-desktop))), var(--layout-content-max)); }
    .project-videos ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
