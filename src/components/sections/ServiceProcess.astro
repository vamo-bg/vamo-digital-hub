---
interface Step { title: string; description: string; }
interface Props { title: string; intro: string; steps: Step[]; id?: string; label?: string; tone?: 'light' | 'dark'; }
const { title, intro, steps, id = 'kak-rabotim', label = 'Как работим', tone = 'light' } = Astro.props;
---

<section class:list={['service-process', steps.length === 3 && 'service-process--three', tone === 'dark' && 'service-process--dark']} id={id} aria-labelledby={`${id}-title`}>
  <div class="service-process__shell">
    <header><p class="service-label">{label}</p><h2 id={`${id}-title`}>{title}</h2><p>{intro}</p></header>
    <ol>{steps.map((step,index)=><li><span aria-hidden="true">{String(index+1).padStart(2,'0')}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></li>)}</ol>
  </div>
</section>

<style>
  .service-process{padding-block:var(--layout-section-padding-mobile);background:var(--color-background)}
  .service-process__shell{width:min(calc(100% - 2 * var(--layout-gutter-mobile)),var(--layout-content-max));margin-inline:auto}
  header{text-align:center}
  .service-label{color:var(--color-vamo-red);font-family:var(--font-heading);font-size:.75rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase}
  h2{margin-block-start:var(--space-3);font-size:var(--type-section-title);font-weight:700;line-height:1.15;letter-spacing:-.02em}
  header>p:last-child{max-width:58rem;margin:var(--space-5) auto 0;color:var(--color-text-muted);font-size:1.0625rem;line-height:1.65}
  ol{position:relative;display:grid;margin:var(--space-10) 0 0;padding:0;list-style:none}
  ol::before{position:absolute;inset-block:var(--space-6);inset-inline-start:1.125rem;border-inline-start:1px dotted var(--color-border-strong);content:''}
  li{position:relative;display:grid;grid-template-columns:2.25rem minmax(0,1fr);gap:var(--space-5);padding-block:var(--space-6);border-block-end:1px dotted var(--color-border-strong)}
  li:first-child{border-block-start:1px dotted var(--color-border-strong)}
  li>span{position:relative;z-index:1;display:grid;width:2.25rem;height:2.25rem;place-items:center;border:1px solid var(--color-vamo-red);border-radius:var(--radius-full);background:var(--color-background);color:var(--color-vamo-red);font-family:var(--font-heading);font-size:.75rem;font-weight:700;font-variant-numeric:tabular-nums}
  h3{font-size:var(--type-card-title);font-weight:600;line-height:1.3}
  li p{margin-block-start:var(--space-3);color:var(--color-text-muted);line-height:1.6}
  .service-process--dark{background:var(--color-vamo-black);color:var(--color-text-inverse)}
  .service-process--dark .service-label,.service-process--dark li>span{color:var(--color-accent-on-dark)}
  .service-process--dark header>p:last-child,.service-process--dark li p{color:var(--color-neutral-300)}
  .service-process--dark ol,.service-process--dark li,.service-process--dark li:first-child,.service-process--dark li:not(:first-child){border-color:var(--color-neutral-800)}
  .service-process--dark ol::before{border-color:var(--color-neutral-800)}
  .service-process--dark li>span{border-color:var(--color-accent-on-dark);background:var(--color-vamo-black)}
  @media(min-width:48rem){
    .service-process{padding-block:var(--layout-section-padding-desktop)}
    .service-process__shell{width:min(calc(100% - 2 * var(--layout-gutter-desktop)),var(--layout-content-max))}
    ol{grid-template-columns:repeat(4,minmax(0,1fr));border-block-start:1px dotted var(--color-border-strong)}
    .service-process--three ol{grid-template-columns:repeat(3,minmax(0,1fr))}
    ol::before{display:none}
    li{grid-template-columns:1fr;align-content:start;gap:var(--space-5);min-height:12rem;padding:0 var(--space-6) var(--space-6);border-block-end:1px dotted var(--color-border-strong)}
    li:first-child{border-block-start:0}
    li:not(:first-child){border-inline-start:1px dotted var(--color-border-strong)}
    li>span{margin-block-start:-1.125rem}
  }
</style>
