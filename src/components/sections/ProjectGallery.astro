---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface GalleryItem {
  image: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="gallery-section" aria-labelledby="gallery-title">
      <div class="gallery-section__heading">
        <p class="gallery-section__eyebrow">В кадър</p>
        <h2 id="gallery-title">Проектът отблизо</h2>
        <p>
          Част от средата, детайлите и съдържанието, създадени за юбилейното
          събитие.
        </p>
      </div>

      <div class="gallery">
        {items.map((item, index) => (
          <figure class:list={['gallery__item', { 'gallery__item--wide': index === 0 || index === 5 }]}>
            <Image
              src={item.image}
              alt={item.alt}
              widths={[480, 720, 1080, 1440]}
              sizes={index === 0 || index === 5 ? '(min-width: 64rem) 64vw, 100vw' : '(min-width: 48rem) 50vw, 100vw'}
              loading="lazy"
            />
            {item.caption && <figcaption>{item.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </section>
  )
}

<style>
  .gallery-section {
    display: grid;
    gap: var(--space-10);
    padding-block: var(--space-20);
  }

  .gallery-section__heading {
    display: grid;
    max-width: 43rem;
    gap: var(--space-4);
  }

  .gallery-section__eyebrow {
    color: var(--color-vamo-red);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .gallery-section h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .gallery-section__heading > p:last-child {
    max-width: 38rem;
    color: var(--color-text-muted);
    font-size: 1.0625rem;
  }

  .gallery {
    display: grid;
    gap: var(--space-4);
  }

  .gallery__item {
    min-width: 0;
    overflow: hidden;
    border-radius: var(--radius-surface);
    background-color: var(--color-surface-strong);
  }

  .gallery__item :global(img) {
    width: 100%;
    height: 100%;
    min-height: 19rem;
    object-fit: cover;
    transition: transform var(--dur-4) var(--ease-out-cubic);
  }

  .gallery__item:hover :global(img) {
    transform: scale(1.015);
  }

  .gallery__item figcaption {
    padding: var(--space-3) var(--space-4);
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  @media (min-width: 48rem) {
    .gallery-section {
      gap: var(--space-12);
      padding-block: var(--space-24);
    }

    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .gallery__item--wide {
      grid-column: 1 / -1;
    }

    .gallery__item :global(img) {
      min-height: 28rem;
      aspect-ratio: 4 / 3;
    }

    .gallery__item--wide :global(img) {
      min-height: 34rem;
      aspect-ratio: 16 / 9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery__item :global(img) {
      transition: none;
    }
  }
</style>
