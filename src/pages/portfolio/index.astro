---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import Button from '../../components/ui/Button.astro';
import ProjectArchiveCard from '../../components/ui/ProjectArchiveCard.astro';
import NetworkPattern from '../../components/ui/NetworkPattern.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EvidenceSection from '../../components/sections/EvidenceSection.astro';
import FinalCtaSection from '../../components/sections/FinalCtaSection.astro';
import portfolioHero from '../../assets/portfolio/portfolio-hero-network.png';

const allProjects = await getCollection('portfolio');
const projects = allProjects
  .filter(({ data }) => import.meta.env.DEV || !data.draft)
  .sort((a, b) => {
    const orderA = a.data.sectionOrder ?? Number.MAX_SAFE_INTEGER;
    const orderB = b.data.sectionOrder ?? Number.MAX_SAFE_INTEGER;
    const yearA = Number(a.data.year ?? 0);
    const yearB = Number(b.data.year ?? 0);

    return orderA - orderB || yearB - yearA || a.data.title.localeCompare(b.data.title, 'bg');
  });

const clients = await getCollection('clients', ({ data }) => !data.draft);
const clientById = new Map(clients.map((client) => [client.id, client.data.name]));

const services = await getCollection('resheniya', ({ data }) => !data.draft);
const serviceById = new Map(services.map((service) => [service.id, service.data.title]));
const pageUrl = new URL('/portfolio/', Astro.site ?? Astro.url).href;
const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Начало', item: new URL('/', Astro.site ?? Astro.url).href },
  { '@type': 'ListItem', position: 2, name: 'Проекти', item: pageUrl },
] };
---

<BaseLayout
  title="Проекти"
  description="Реални проекти, събития и комуникационни решения, реализирани от VAMO за бизнеси, институции и организации."
>
  <Fragment slot="head"><script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} /></Fragment>
  <article class="portfolio-page">
    <div class="portfolio-crumbs">
      <nav class="portfolio-shell breadcrumbs" aria-label="Навигация по местоположението"><a href="/">Начало</a><span aria-hidden="true">/</span><span aria-current="page">Проекти</span></nav>
    </div>
    <header class="portfolio-intro">
      <NetworkPattern />
      <div class="portfolio-shell portfolio-intro__inner">
        <div class="portfolio-intro__copy">
          <p class="portfolio-intro__eyebrow">Портфолио</p>
          <h1>Проекти, в които стратегията става резултат</h1>
          <p>
            Подбрани реализации, които показват не само крайния образ, а задачата,
            решенията и реалната работа зад него.
          </p>
          <Button href="/kontakti/" size="md">Обсъдете вашия проект</Button>
        </div>
        <aside class="portfolio-intro__media" aria-label="Избран кадър от проект">
          <div class="portfolio-intro__media-frame">
            <Image src={portfolioHero} alt="Визуална карта на проектите и експертизата на VAMO" widths={[480, 720, 960, 1200]} sizes="(min-width: 64rem) 40rem, (min-width: 48rem) 50vw, 100vw" loading="eager"
            fetchpriority="high" />
          </div>
        </aside>
      </div>
    </header>

    <section class="portfolio-list" aria-label="Всички проекти">
      <div class="portfolio-shell">
        {
          projects.length > 0 ? (
            <div class="portfolio-grid">
              {projects.map((project, index) => (
                <ProjectArchiveCard
                  project={project}
                  clientName={clientById.get(project.data.clientId) ?? project.data.clientId}
                  serviceNames={project.data.serviceIds
                    .map((id) => serviceById.get(id))
                    .filter((name): name is string => name !== undefined)}
                  featured={index === 0}
                  preview={project.data.draft}
                />
              ))}
            </div>
          ) : (
            <p class="portfolio-empty">
              Подготвяме първите подробни проектни истории.
            </p>
          )
        }
      </div>
    </section>
    <EvidenceSection />
    <FinalCtaSection title="Имате задача, която трябва да стане реален резултат?" description="Разкажете ни контекста и ще подредим най-смисления следващ ход." actionLabel="Обсъдете вашия проект" />
  </article>
</BaseLayout>

<style>
  .portfolio-page {
    background-color: var(--color-cream);
  }

  .portfolio-shell {
    width: min(
      calc(100% - (2 * var(--layout-gutter-mobile))),
      var(--layout-content-max)
    );
    margin-inline: auto;
  }

  .portfolio-crumbs { border-block: 1px solid var(--color-border); background: var(--color-surface); }
  .breadcrumbs { display: flex; min-height: 2.75rem; align-items: center; gap: var(--space-2); color: var(--color-text-muted); font-size: .875rem; }
  .breadcrumbs a { color: inherit; text-decoration: none; }
  .breadcrumbs a:hover { color: var(--color-vamo-red); }
  .breadcrumbs a:focus-visible { border-radius: var(--radius-control); outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .breadcrumbs span[aria-hidden='true'] { color: var(--color-neutral-400); }
  .breadcrumbs span[aria-current='page'] { color: var(--color-text); font-weight: 600; }

  .portfolio-intro { position: relative; overflow: hidden; background: var(--color-vamo-black); color: var(--color-text-inverse); }
  .portfolio-intro > :global(.network-pattern) { opacity: .68; }
  .portfolio-intro__inner { position: relative; z-index: 1; display: grid; gap: var(--space-10); padding-block: var(--layout-anchor-padding-mobile); }
  .portfolio-intro__copy { display: grid; gap: var(--space-4); max-width: 48rem; }
  .portfolio-intro__eyebrow { color: var(--color-accent-on-dark); font-size: .75rem; font-weight: 700; letter-spacing: .12em; line-height: 1.4; text-transform: uppercase; }

  .portfolio-intro h1 {
    max-width: 18ch;
    font-size: var(--type-page-title);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .portfolio-intro__copy > p:not(.portfolio-intro__eyebrow) { max-width: 58ch; color: var(--color-neutral-300); font-size: 1.125rem; line-height: 1.6; text-wrap: pretty; }
  .portfolio-intro__copy :global(.button) { justify-self: start; margin-block-start: var(--space-2); }
  .portfolio-intro__media { display: grid; width: 100%; max-width: 40rem; color: var(--color-neutral-300); font-size: 1rem; line-height: 1.55; }
  .portfolio-intro__media-frame { position: relative; display: block; aspect-ratio: 16 / 10; border: 1px solid var(--color-neutral-600); border-radius: var(--radius-surface); background: var(--color-neutral-800); overflow: hidden; }
  .portfolio-intro__media-frame :global(img) { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }

  .portfolio-list {
    padding-block: var(--layout-section-padding-mobile);
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-16) var(--space-8);
  }

  .portfolio-empty {
    max-width: 38rem;
    color: var(--color-text-muted);
    font-size: 1.0625rem;
  }

  @media (min-width: 48rem) {
    .portfolio-shell {
      width: min(
        calc(100% - (2 * var(--layout-gutter-desktop))),
        var(--layout-content-max)
      );
    }

    .portfolio-intro__inner {
      grid-template-columns: minmax(0, 1fr) minmax(24rem, .75fr);
      align-items: start;
      padding-block: var(--layout-anchor-padding-desktop);
    }

    .portfolio-intro__media { justify-self: end; }

    .portfolio-list {
      padding-block: var(--layout-section-padding-desktop);
    }
  }

  @media (min-width: 64rem) {
    .portfolio-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-20) var(--space-10);
    }

    .portfolio-grid :global(.archive-card:first-child) {
      grid-column: 1 / -1;
    }
  }
</style>
