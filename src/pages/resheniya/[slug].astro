---
import { getCollection, getEntries, render } from 'astro:content';

import ServiceDifference from '../../components/sections/ServiceDifference.astro';
import ServiceHero from '../../components/sections/ServiceHero.astro';
import ServiceProblem from '../../components/sections/ServiceProblem.astro';
import ServiceProcess from '../../components/sections/ServiceProcess.astro';
import ServiceProjects from '../../components/sections/ServiceProjects.astro';
import ServiceScope from '../../components/sections/ServiceScope.astro';
import ServiceExperts from '../../components/sections/ServiceExperts.astro';
import Button from '../../components/ui/Button.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import communicationPrImage from '../../assets/service-komunikatsii-pr.png';
import businessReadyScoreImage from '../../assets/service-business-ready-score.png';
import digitalStrategyImage from '../../assets/service-digitalna-strategiya.png';
import designMaterialsImage from '../../assets/service-dizayn-reklamni-materiali.png';
import euVisibilityImage from '../../assets/service-eu-visibility-compliance.png';
import podcastInterviewImage from '../../assets/service-podcast-interview.png';
import eventsLogisticsImage from '../../assets/service-sabitiya-logistika.png';
import videoFilmImage from '../../assets/service-video-filmovo-proizvodstvo.png';
import webDevelopmentImage from '../../assets/service-ueb-razrabotka.png';
import organicDistributionImage from '../../assets/service-organichno-razprostranenie.png';

const solutionImages = {
  'business-ready-score': businessReadyScoreImage,
  'komunikatsii-i-pr': communicationPrImage,
  'digitalna-strategiya': digitalStrategyImage,
  'dizayn-i-reklamni-materiali': designMaterialsImage,
  'eu-visibility-compliance': euVisibilityImage,
  'podkast-i-intervyu-formati': podcastInterviewImage,
  'sabitiya-i-logistika': eventsLogisticsImage,
  'video-i-filmovo-proizvodstvo': videoFilmImage,
  'ueb-razrabotka': webDevelopmentImage,
  'organichno-razprostranenie': organicDistributionImage,
} as const;

// Огледално на resheniya/index.astro — снимката е декоративна (hero визуалът
// е aria-hidden), но описанието остава полезно за image search/AI индексиране.
const solutionImageAlt = {
  'business-ready-score': 'Лупа над мрежа от свързани точки с осветен път — символ на анализ и ясни приоритети за развитие.',
  'komunikatsii-i-pr': 'Абстрактна 3D визуализация на светещ възел, излъчващ сигнал към свързани точки — символ на комуникация и обхват.',
  'digitalna-strategiya': 'Абстрактна 3D визуализация на пътека от свързани точки, водеща до осветен връх — символ на стратегическа посока.',
  'dizayn-i-reklamni-materiali': 'Композиция от печатни рекламни материали — плакати, визитки, руло с банер и цветова палитра.',
  'eu-visibility-compliance': 'Абстрактна 3D визуализация на документ, свързан с прозрачни панели — символ на отчетност по европейски проекти.',
  'podkast-i-intervyu-formati': 'Абстрактна 3D визуализация на микрофони и икони на диалог, свързани около звукова вълна.',
  'sabitiya-i-logistika': 'Абстрактна 3D визуализация на сграда, камион, календар и локация, свързани в мрежа — символ на логистика за събития.',
  'video-i-filmovo-proizvodstvo': 'Абстрактна 3D визуализация на камера, осветление, микрофон, филмова ролка и монтажен екран, свързани в мрежа.',
  'ueb-razrabotka': 'Абстрактна 3D визуализация на централен възел, свързан с устройства и екрани — символ на уеб разработка.',
  'organichno-razprostranenie': 'Абстрактна 3D визуализация на история, която достига до различни местни, културни и туристически общности чрез внимателно подбрани връзки.',
} as const;

export async function getStaticPaths() {
  const solutions = await getCollection('resheniya', ({ data }) => !data.draft);
  return solutions.map((solution) => ({ params: { slug: solution.id }, props: { solution } }));
}

const { solution } = Astro.props;
const { Content } = await render(solution);
const { title, description, seoTitle, seoDescription, heroStatement, heroDetails, problems, difference, process, inclusions, editorialSections, ctaTitle, ctaLabel } = solution.data;
const hasStructuredContent = Boolean(problems || difference || process || inclusions);
const solutionImage = solutionImages[solution.id as keyof typeof solutionImages];

const relatedProjects = (
  await getCollection('portfolio', ({ data }) =>
    (import.meta.env.DEV || !data.draft) && data.serviceIds.includes(solution.id),
  )
).sort((a, b) => Number(b.data.year ?? 0) - Number(a.data.year ?? 0));

const clients = await getCollection('clients', ({ data }) => !data.draft);
const clientNames = Object.fromEntries(clients.map((client) => [client.id, client.data.name]));
const allExperts = await getCollection('eksperti', ({ data }) => data.active && !data.draft);
const relatedExperts = (
  await Promise.all(
    allExperts.map(async (expert) => ({
      expert,
      services: await getEntries(expert.data.services),
    })),
  )
)
  .filter(({ services }) => services.some((service) => service.id === solution.id))
  .map(({ expert }) => expert)
  .slice(0, 3);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Начало', item: new URL('/', Astro.url).href },
    { '@type': 'ListItem', position: 2, name: 'Решения', item: new URL('/resheniya/', Astro.url).href },
    { '@type': 'ListItem', position: 3, name: title, item: Astro.url.href },
  ],
};
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${Astro.url.href}#service`,
  name: title,
  description: seoDescription ?? description,
  url: Astro.url.href,
  provider: { '@id': `${new URL('/', Astro.site ?? Astro.url).href}#organization` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': Astro.url.href },
};
---

<BaseLayout title={seoTitle ?? title} titleSuffix={false} description={seoDescription ?? description} image={solutionImage}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)}></script>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)}></script>
  <article>
    <div class="service-breadcrumbs-bar">
      <nav class="service-shell service-breadcrumbs" aria-label="Навигация">
        <a href="/">Начало</a><span aria-hidden="true">/</span>
        <a href="/resheniya/">Решения</a><span aria-hidden="true">/</span>
        <span aria-current="page">{title}</span>
      </nav>
    </div>

    <ServiceHero
      title={title}
      statement={heroStatement ?? description}
      details={heroDetails ?? description}
      image={solutionImage}
      imageAlt={solutionImageAlt[solution.id as keyof typeof solutionImageAlt]}
    />
    {problems && <ServiceProblem {...problems} />}
    {difference && <ServiceDifference {...difference} />}
    {process && <ServiceProcess {...process} />}
    {inclusions && <ServiceScope {...inclusions} />}

    {editorialSections?.length && (
      <section class="service-editorial" aria-label={`Още за ${title}`}>
        <div class="service-shell service-editorial__inner">
          {editorialSections.map((section, index) => (
            <section class="service-editorial__item" aria-labelledby={`editorial-${index}`}>
              <h2 id={`editorial-${index}`}>{section.title}</h2>
              <div>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
            </section>
          ))}
        </div>
      </section>
    )}

    {!hasStructuredContent && (
      <section class="service-fallback" aria-label={`Повече за ${title}`}>
        <div class="service-shell service-fallback__body"><Content /></div>
      </section>
    )}

    {relatedProjects.length > 0 && <ServiceProjects projects={relatedProjects} clientNames={clientNames} />}
    <ServiceExperts experts={relatedExperts} />

    <section class="service-cta" aria-labelledby="service-cta-title">
      <div class="service-shell service-cta__inner">
        <div><p>Следващата стъпка</p><h2 id="service-cta-title">{ctaTitle ?? 'Нека подредим комуникацията ви'}</h2></div>
        <Button href="/kontakti/" size="lg">{ctaLabel ?? 'Започнете разговор'}</Button>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .service-shell{width:min(calc(100% - 2 * var(--layout-gutter-mobile)),var(--layout-content-max));margin-inline:auto}
  .service-breadcrumbs-bar{background:var(--color-surface);border-block:1px solid var(--color-border)}
  .service-breadcrumbs{display:flex;overflow:hidden;min-height:2.75rem;align-items:center;gap:var(--space-2);color:var(--color-text-muted);font-family:var(--font-ui);font-size:.875rem;line-height:1.5;white-space:nowrap}
  .service-breadcrumbs a{display:inline-flex;align-items:center;min-height:2.75rem;color:var(--color-text-muted);font-weight:500;text-decoration-color:transparent;text-decoration-thickness:1px;text-underline-offset:var(--space-1);transition:color var(--dur-2) ease,text-decoration-color var(--dur-2) ease}
  .service-breadcrumbs a:hover{color:var(--color-vamo-red);text-decoration-color:currentColor}
  .service-breadcrumbs a:focus-visible{border-radius:var(--radius-control);outline:2px solid var(--color-focus);outline-offset:2px}
  .service-breadcrumbs span[aria-hidden='true']{color:var(--color-neutral-400)}
  .service-breadcrumbs span[aria-current='page']{overflow:hidden;color:var(--color-text);font-weight:600;text-overflow:ellipsis}
  .service-fallback{padding-block:var(--layout-section-padding-mobile)}
  .service-fallback__body{max-width:48rem}
  .service-fallback__body :global(h2){margin-block:var(--space-10) var(--space-4);font-size:var(--type-section-title)}
  .service-fallback__body :global(p),.service-fallback__body :global(li){color:var(--color-text-muted);font-size:1.0625rem;line-height:1.7}
  .service-editorial{padding-block:var(--layout-section-padding-mobile);background:var(--color-neutral-100)}
  .service-editorial__inner{display:grid;gap:var(--space-12)}
  .service-editorial__item{display:grid;gap:var(--space-5);max-width:70rem}
  .service-editorial__item h2{max-width:18ch;font-size:var(--type-section-title);font-weight:700;line-height:1.12;letter-spacing:-.02em;text-wrap:balance}
  .service-editorial__item div{display:grid;gap:var(--space-5);max-width:62ch}
  .service-editorial__item p{color:var(--color-text-muted);font-size:1.0625rem;line-height:1.7}
  .service-cta__inner>div>p{font-family:var(--font-heading);font-size:.75rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase}
  .service-cta__inner>div>p{color:var(--color-accent-on-dark)}
  .service-cta h2{margin-block-start:var(--space-3);font-size:var(--type-cta-title);font-weight:700;line-height:1.15;letter-spacing:-.02em}
  .service-cta{padding-block:var(--layout-anchor-padding-mobile);background:var(--color-vamo-black);color:var(--color-text-inverse)}
  .service-cta__inner{display:grid;gap:var(--space-8)}
  .service-cta__inner :global(.button){justify-self:start}
  @media(min-width:48rem){
    .service-shell{width:min(calc(100% - 2 * var(--layout-gutter-desktop)),var(--layout-content-max))}
    .service-fallback{padding-block:var(--layout-section-padding-desktop)}
    .service-editorial{padding-block:var(--layout-section-padding-desktop)}
    .service-editorial__item{grid-template-columns:minmax(0,.7fr) minmax(0,1.3fr);gap:var(--space-12)}
    .service-cta{padding-block:var(--layout-anchor-padding-desktop)}
    .service-cta__inner{grid-template-columns:minmax(0,1fr) auto;align-items:end}
    .service-cta__inner :global(.button){justify-self:end}
  }
</style>
