---
import LegalPagePlaceholder from '../../components/sections/LegalPagePlaceholder.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const title = 'Общи условия';
const entry = await getEntry('legal', 'obshti-usloviya');
const { Content } = await render(entry!);
---

<BaseLayout
  title={title}
  description="Условия за използване на сайта на VAMO."
  noindex
>
  <LegalPagePlaceholder
    title={title}
    summary="Условия за използване на сайта на VAMO."
  ><Content /></LegalPagePlaceholder>
</BaseLayout>
