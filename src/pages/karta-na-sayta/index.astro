---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Карта на сайта';
const description = 'Пълен преглед на страниците, услугите, проектите, експертите, клиентите и публикациите на VAMO.';
// `title` захранва и breadcrumb-а (къс label), затова SEO <title> е отделен.
const seoTitle = 'Карта на сайта — всички страници';
const pageUrl = new URL('/karta-na-sayta/', Astro.site ?? Astro.url).href;
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Начало', item: new URL('/', Astro.site ?? Astro.url).href },
    { '@type': 'ListItem', position: 2, name: title, item: pageUrl },
  ],
};

const compareTitles = <T extends { data: { title?: string; name?: string; order?: number } }>(a: T, b: T) =>
  (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER) ||
  (a.data.title ?? a.data.name ?? '').localeCompare(b.data.title ?? b.data.name ?? '', 'bg');

const [solutions, projects, experts, clients, posts] = await Promise.all([
  getCollection('resheniya', ({ data }) => !data.draft),
  getCollection('portfolio', ({ data }) => !data.draft),
  getCollection('eksperti', ({ data }) => !data.draft && data.active),
  getCollection('clients', ({ data }) => !data.draft),
  getCollection('blog', ({ data }) => !data.draft),
]);

const primaryPages = [
  { label: 'Начало', href: '/' },
  { label: 'За нас', href: '/za-nas/' },
  { label: 'Как работим', href: '/kak-rabotim/' },
  { label: 'Контакти', href: '/kontakti/' },
  { label: 'Референции', href: '/referentsii/' },
];

const groups = [
  { title: 'Основни страници', items: primaryPages },
  { title: 'Решения', items: solutions.sort(compareTitles).map((entry) => ({ label: entry.data.title, href: `/resheniya/${entry.id}/` })) },
  { title: 'Проекти', items: projects.sort(compareTitles).map((entry) => ({ label: entry.data.title, href: `/portfolio/${entry.id}/` })) },
  { title: 'Експертна мрежа', items: experts.sort(compareTitles).map((entry) => ({ label: entry.data.name, href: `/ekspertna-mrezha/${entry.id}/` })) },
  { title: 'Клиенти', items: clients.sort(compareTitles).map((entry) => ({ label: entry.data.name, href: `/klienti/${entry.id}/` })) },
  { title: 'Блог', items: posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).map((entry) => ({ label: entry.data.title, href: `/blog/${entry.id}/` })) },
];

const legalPages = [
  { label: 'Политика за поверителност', href: '/politika-za-poveritelnost/' },
  { label: 'Общи условия', href: '/obshti-usloviya/' },
  { label: 'Бисквитки', href: '/biskvitki/' },
];
---

<BaseLayout title={seoTitle} description={description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <article class="sitemap-page">
    <div class="sitemap-crumbs">
      <nav class="sitemap-shell breadcrumbs" aria-label="Навигация по местоположението">
        <a href="/">Начало</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{title}</span>
      </nav>
    </div>

    <header class="sitemap-hero">
      <div class="sitemap-shell">
        <h1>Карта на сайта</h1>
        <p>Всички публични страници и съдържание на VAMO са събрани на едно място.</p>
      </div>
    </header>

    <section class="sitemap-content" aria-label="Страници в сайта">
      <div class="sitemap-shell">
        <div class="sitemap-groups">
          {groups.map((group) => (
            <section class="sitemap-group" aria-labelledby={`group-${group.title}`}>
              <h2 id={`group-${group.title}`}>{group.title}</h2>
              {group.items.length > 0 ? (
                <ul>
                  {group.items.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
                </ul>
              ) : (
                <p>Съдържанието предстои.</p>
              )}
            </section>
          ))}
        </div>

        <section class="sitemap-legal" aria-labelledby="legal-title">
          <h2 id="legal-title">Правна информация</h2>
          <ul>{legalPages.map((page) => <li><a href={page.href}>{page.label}</a></li>)}</ul>
        </section>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .sitemap-page { background: var(--color-cream); }
  .sitemap-shell { width: min(calc(100% - (2 * var(--layout-gutter-mobile))), var(--layout-content-max)); margin-inline: auto; }
  .sitemap-crumbs { border-block: 1px solid var(--color-border); background: var(--color-surface); }
  .breadcrumbs { display: flex; min-height: 2.75rem; align-items: center; gap: var(--space-2); color: var(--color-text-muted); font-size: .875rem; }
  .breadcrumbs a { color: inherit; text-decoration: none; }
  .breadcrumbs a:hover { color: var(--color-vamo-red); }
  .breadcrumbs a:focus-visible { border-radius: var(--radius-control); outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .breadcrumbs span[aria-hidden='true'] { color: var(--color-neutral-400); }
  .breadcrumbs span[aria-current='page'] { color: var(--color-text); font-weight: 600; }

  .sitemap-hero { padding-block: var(--layout-anchor-padding-mobile); border-block-end: 1px solid var(--color-border); background: var(--color-neutral-100); }
  .sitemap-hero h1 { max-width: 13ch; font-size: var(--type-page-title); font-weight: 700; line-height: 1.08; letter-spacing: -.03em; text-wrap: balance; }
  .sitemap-hero p { max-width: 54ch; margin-block-start: var(--space-5); color: var(--color-text-muted); font-size: 1.125rem; line-height: 1.6; text-wrap: pretty; }

  .sitemap-content { padding-block: var(--layout-anchor-padding-mobile); }
  .sitemap-groups { display: grid; border-block-start: 1px solid var(--color-border-strong); }
  .sitemap-group { display: grid; gap: var(--space-5); padding-block: var(--space-8); border-block-end: 1px solid var(--color-border); }
  .sitemap-group h2, .sitemap-legal h2 { font-size: var(--type-card-title); font-weight: 600; line-height: 1.3; letter-spacing: -.02em; }
  .sitemap-group ul, .sitemap-legal ul { display: grid; gap: var(--space-1); margin: 0; padding: 0; list-style: none; }
  .sitemap-group a, .sitemap-legal a { display: inline-flex; min-height: 2.75rem; align-items: center; color: var(--color-text); font-size: 1rem; line-height: 1.5; text-decoration-color: var(--color-border-strong); text-underline-offset: var(--space-1); }
  .sitemap-group a:hover, .sitemap-legal a:hover { color: var(--color-vamo-red); text-decoration-color: currentColor; }
  .sitemap-group a:focus-visible, .sitemap-legal a:focus-visible { border-radius: var(--radius-control); outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .sitemap-group p { color: var(--color-text-muted); line-height: 1.65; }
  .sitemap-legal { display: grid; gap: var(--space-5); margin-block-start: var(--space-10); padding-block-start: var(--space-8); border-block-start: 1px solid var(--color-border-strong); }

  @media (min-width: 48rem) {
    .sitemap-shell { width: min(calc(100% - (2 * var(--layout-gutter-desktop))), var(--layout-content-max)); }
    .sitemap-hero, .sitemap-content { padding-block: var(--layout-anchor-padding-desktop); }
    .sitemap-groups { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sitemap-group { padding: var(--space-8); }
    .sitemap-group:nth-child(odd) { padding-inline-start: 0; }
    .sitemap-group:nth-child(even) { border-inline-start: 1px solid var(--color-border); }
    .sitemap-legal { grid-template-columns: minmax(14rem, .65fr) minmax(0, 1.35fr); gap: var(--space-16); align-items: start; }
  }
</style>
