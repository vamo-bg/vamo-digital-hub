---
import { Image } from 'astro:assets';

import ContactForm from '../components/ui/ContactForm.astro';
import Button from '../components/ui/Button.astro';
import CataloguesSection from '../components/sections/CataloguesSection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CheckMark from '../components/ui/CheckMark.astro';
import PromoBadge from '../components/ui/PromoBadge.astro';
import galleryStenenKalendar from '../assets/reklamni-materiali/stenen-kalendar-2027-vamo.webp';
import galleryNastolenKalendar from '../assets/reklamni-materiali/nastolen-kalendar-2027-vamo.webp';
import galleryNarodniTradicii from '../assets/reklamni-materiali/kalendar-narodni-tradicii-vamo.webp';
import galleryDvumesechenKalendar from '../assets/reklamni-materiali/dvumesechen-kalendar-vamo.webp';
import galleryTefterKork from '../assets/reklamni-materiali/tefter-kork-vamo.webp';
import galleryKnigorazdeliteli from '../assets/reklamni-materiali/knigorazdeliteli-vamo.webp';
import galleryTefterChernoCherven from '../assets/reklamni-materiali/tefter-cherno-cherven-vamo.webp';
import galleryButilki from '../assets/reklamni-materiali/butilki-za-voda-vamo.webp';
import galleryTermochashi from '../assets/reklamni-materiali/termochashi-vamo.webp';
import galleryRanici from '../assets/reklamni-materiali/ranici-s-logo-vamo.webp';
import galleryChervenoPolo from '../assets/reklamni-materiali/cherveno-polo-vamo.webp';
import gallerySuitshart from '../assets/reklamni-materiali/suitshart-s-logo-vamo.webp';
import galleryChervenElek from '../assets/reklamni-materiali/cherven-ekip-vamo.webp';
import galleryShapkaSnapback from '../assets/reklamni-materiali/shapka-snapback-vamo.webp';
import galleryKomplektButilka from '../assets/reklamni-materiali/komplekt-tefter-i-butilka-vamo.webp';
import galleryKomplektHimikalka from '../assets/reklamni-materiali/komplekt-tefter-i-himikalka-vamo.webp';
import vamoWhiteLogo from '../assets/reklamni-materiali/vamo-white.png';
import heroBackground from '../assets/reklamni-materiali/hero-ekip.webp';
import socialImage from '../assets/reklamni-materiali/og-reklamni-materiali.jpg';
import produktZapalka from '../assets/reklamni-materiali/produkt-zapalka.webp';
import produktTeniski from '../assets/reklamni-materiali/produkt-teniski.webp';
import produktYake from '../assets/reklamni-materiali/produkt-yake.webp';
import produktShapka from '../assets/reklamni-materiali/produkt-shapka.webp';
import produktRakavitsa from '../assets/reklamni-materiali/produkt-rakavitsa.webp';
import produktHimikalka from '../assets/reklamni-materiali/produkt-himikalka.webp';
import produktKalendar from '../assets/reklamni-materiali/produkt-kalendar.webp';
import produktFenerche from '../assets/reklamni-materiali/produkt-fenerche.webp';
import catalogMalfiniCover from '../assets/reklamni-materiali/korica-katalog-malfini-2026.webp';
import catalogKalendariCover from '../assets/reklamni-materiali/korica-katalog-kalendari-2027.webp';
import partnerStricker from '../assets/reklamni-materiali/partner-stricker.webp';
import partnerOfficeMarket from '../assets/reklamni-materiali/partner-officemarket.gif';
import partnerMalfini from '../assets/reklamni-materiali/partner-malfini.png';
import partnerPrisma from '../assets/reklamni-materiali/partner-prisma.svg';
import partnerEkstrapak from '../assets/reklamni-materiali/partner-ekstrapak.webp';
import { site } from '../data/site';

const catalogues = [
  {
    label: 'Malfini · 2026',
    title: 'Каталог 2026: промоционално облекло',
    description: 'Тениски, поло, суичъри и аксесоари за брандиране – модели, цветове и размери в 210 страници. Каталогът е на английски език.',
    details: 'PDF · 210 страници · 12,5 MB',
    href: '/documents/catalogues/vamo-katalog-malfini-2026.pdf',
    cover: catalogMalfiniCover,
    coverAlt: 'Корица на каталог 2026 на Malfini с промоционално облекло',
  },
  {
    label: 'ВАМО · 2027',
    title: 'Календарна кампания 2027',
    description: 'Стенни и настолни календари за 2027 г. – природа, пътешествия, традиции и градове. Формати, хартия и място за рекламен надпис.',
    details: 'PDF · 14 страници · 3,2 MB',
    href: '/documents/catalogues/vamo-kalendari-2027.pdf',
    cover: catalogKalendariCover,
    coverAlt: 'Корица на каталог „Календарна кампания 2027“ на ВАМО',
  },
];

const title = 'Рекламни материали и бизнес подаръци';
const description = 'Брандирани рекламни материали, бизнес подаръци и персонализирани комплекти за клиенти, партньори, екипи и събития.';
const pageUrl = new URL('/biznes-podaratsi/', Astro.site ?? Astro.url).href;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: title,
  description,
  url: pageUrl,
  provider: { '@id': `${new URL('/', Astro.site ?? Astro.url).href}#organization` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
};

const categories = [
  ['Бизнес комплекти', 'Съчетаваме предмети и опаковка в подарък, който изглежда завършен и уместен за повода.'],
  ['Подаръци с лого', 'Подбираме практични продукти и подходящ начин за брандиране според вашата идентичност.'],
  ['Тефтери, календари и картички', 'Подготвяме полезни печатни формати за ежедневна употреба, поздрав или дългосрочно присъствие.'],
  ['Материали за събития', 'Създаваме видими и последователни детайли за срещи, конференции и представяния.'],
];

const process = [
  ['01', 'Уточняваме повода', 'Говорим за хората, бюджета, броя комплекти и момента, в който подаръкът ще бъде получен.'],
  ['02', 'Подбираме решение', 'Предлагаме комбинация от продукти, материали и брандиране, съобразена с вашата задача.'],
  ['03', 'Подготвяме визията', 'Адаптираме логото и посланието така, че да стоят естествено върху избрания формат.'],
  ['04', 'Координираме реализацията', 'Проследяваме подготовката на материалите до готовия за използване комплект.'],
];

const heroFeatures = [
  'Бизнес комплекти',
  'Подаръчни комплекти с лого',
  'Картички с фирмено брандиране',
  'Стенни календари',
  'Планери и тефтери',
];

const whyReasons = [
  { title: 'Директен внос от европейски складове', detail: '– доставка до 5 дни' },
  { title: 'Възможност за покупка на изплащане с TBI', detail: '(минимална стойност 150 лв.)' },
  { title: 'Гъвкави решения', detail: 'за различни бюджети' },
  { title: 'Екологични и персонализирани продукти', detail: 'с нов дизайн 2026' },
  { title: 'Пълен бранд мениджмънт', detail: '– от концепция до финален продукт' },
];

const whyImages = [
  { src: produktZapalka, alt: 'Брандирана метална запалка с лого' },
  { src: produktTeniski, alt: 'Две червени тениски с брандиране' },
  { src: produktYake, alt: 'Червено поларено яке с брандиране' },
  { src: produktShapka, alt: 'Червена шапка с брандиране' },
  { src: produktRakavitsa, alt: 'Ръкавица за фурна с брандиране' },
  { src: produktHimikalka, alt: 'Химикалка с гравирано лого' },
  { src: produktKalendar, alt: 'Настолен календар с брандиране' },
  { src: produktFenerche, alt: 'Метално фенерче за ключодържател с лого' },
];

const galleryImages = [
  { src: galleryStenenKalendar, alt: 'Стенен календар ВАМО за 2027 г. с български пейзажи и рекламно поле' },
  { src: galleryNarodniTradicii, alt: 'Стенен календар с народни традиции и български носии' },
  { src: galleryTefterKork, alt: 'Тефтер с корична корица и брандиране на ВАМО' },
  { src: galleryChervenoPolo, alt: 'Червена поло тениска с брандиране на ВАМО' },
  { src: galleryNastolenKalendar, alt: 'Настолен календар пирамида ВАМО за 2027 г. с рекламно поле' },
  { src: galleryDvumesechenKalendar, alt: 'Двумесечен календар ВАМО с луксозна корица' },
  { src: galleryButilki, alt: 'Бутилки за вода с лого на ВАМО в четири цвята' },
  { src: gallerySuitshart, alt: 'Черен суитшърт с брандиране на ВАМО' },
  { src: galleryKomplektHimikalka, alt: 'Подаръчен комплект тефтер и химикалка в кутия с лого на ВАМО' },
  { src: galleryRanici, alt: 'Раници и чанти с брандиране на ВАМО' },
  { src: galleryShapkaSnapback, alt: 'Бейзболна шапка snapback с лого на ВАМО' },
  { src: galleryTermochashi, alt: 'Термочаши и бутилки за кафе с брандиране на ВАМО' },
  { src: galleryKnigorazdeliteli, alt: 'Книгоразделител с лепящи листчета и лого на ВАМО' },
  { src: galleryChervenElek, alt: 'Червен елек с цип и брандиране на ВАМО' },
  { src: galleryTefterChernoCherven, alt: 'Тефтер в черно и червено с брандиране на ВАМО' },
  { src: galleryKomplektButilka, alt: 'Подаръчен комплект тефтер и бутилка за вода с брандиране на ВАМО' },
];

const partners = [
  { name: 'Stricker', logo: partnerStricker, alt: 'Лого на Stricker', copy: 'Международен производител с присъствие в 100 държави' },
  { name: 'Офис Маркет', logo: partnerOfficeMarket, alt: 'Лого на Офис Маркет', copy: 'Производител на календари за корпоративни клиенти' },
  { name: 'MALFINI', logo: partnerMalfini, alt: 'Лого на MALFINI', copy: 'Висококачествен текстил и промоционални облекла' },
  { name: 'Prisma', logo: partnerPrisma, alt: 'Лого на Prisma', copy: 'Рекламни аксесоари и бизнес подаръци' },
  { name: 'Екстрапак АД', logo: partnerEkstrapak, alt: 'Лого на СЕП Екстрапак', copy: 'Чанти и опаковки от устойчиви материали' },
];
---

<BaseLayout
  title="Рекламни материали и бизнес подаръци | VAMO"
  titleSuffix={false}
  description={description}
  socialTitle="Рекламни материали и бизнес подаръци от VAMO"
  image={socialImage}
  hideHeader
  hideFooter
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </Fragment>

  <article class="gifts-page">
    <header class="gifts-hero">
      <Image
        class="gifts-hero__bg"
        src={heroBackground}
        alt=""
        width={1920}
        height={980}
        widths={[768, 1280, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="gifts-shell gifts-hero__inner">
        <p class="gifts-hero__eyebrow">ВАМО</p>
        <h1>Рекламни материали и сувенири, които работят за вашия бранд</h1>
        <p class="gifts-hero__lead">Създайте впечатление, което остава дълго след срещата.</p>
        <p class="gifts-hero__body">
          От идеи до реализация – изберете най-подходящите <strong>бизнес подаръци</strong>,{' '}
          <strong>календари</strong>, <strong>тефтери</strong> и <strong>персонализирани комплекти</strong>{' '}
          за вашите клиенти и партньори.
        </p>
        <div class="gifts-hero__actions">
          <Button href="#zapitvane" size="lg">
            <PromoBadge>Промоция</PromoBadge>
            Поръчайте своя рекламен комплект
          </Button>
          <Button href="#catalog" variant="ghost" size="lg" class="gifts-hero__secondary">Разгледайте каталога</Button>
        </div>
        <Image class="gifts-hero__logo" src={vamoWhiteLogo} alt="" width={1200} height={360} widths={[180, 360]} sizes="200px" loading="eager" />
        <ul class="gifts-hero__features">
          {heroFeatures.map((feature) => (
            <li>
              <CheckMark />
              {feature}
            </li>
          ))}
        </ul>
      </div>
    </header>

    <section class="gifts-why" aria-labelledby="why-title">
      <div class="gifts-shell gifts-why__inner">
        <div class="gifts-why__copy">
          <h2 id="why-title">Защо да изберете <span>ВАМО</span></h2>
          <p class="gifts-why__lead">25 години опит. Едно доверие. Хиляди реализирани кампании.</p>
          <p class="gifts-why__body">Вече четвърт век ВАМО е партньор на институции, бизнеси и организации в Югозападна България и извън нея. Ние не просто доставяме рекламни материали – създаваме комуникация, която говори вместо вас.</p>
          <ul class="gifts-why__list">
            {whyReasons.map((reason) => (
              <li>
                <CheckMark />
                <span><strong>{reason.title}</strong> {reason.detail}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="gifts-why__media" data-gifts-slider>
          <div class="gifts-why__stage">
            <ul class="gifts-why__track" data-gifts-track aria-label="Примери за брандирани продукти">
              {whyImages.map((image) => (
                <li class="gifts-why__slide">
                  <Image
                    src={image.src}
                    alt={image.alt}
                    width={768}
                    height={768}
                    widths={[400, 512, 768]}
                    sizes="(min-width: 64rem) min(32rem, calc(47.5vw - 4.75rem)), (min-width: 48rem) 32rem, calc(100vw - 2rem)"
                    loading="lazy"
                  />
                </li>
              ))}
            </ul>
            <button class="gifts-why__arrow gifts-why__arrow--prev" type="button" data-gifts-prev aria-label="Предишен пример">
              <i class="ph ph-caret-left" aria-hidden="true"></i>
            </button>
            <button class="gifts-why__arrow gifts-why__arrow--next" type="button" data-gifts-next aria-label="Следващ пример">
              <i class="ph ph-caret-right" aria-hidden="true"></i>
            </button>
          </div>
          <div class="gifts-why__dots">
            {whyImages.map((image, index) => (
              <button type="button" data-gifts-dot aria-label={`Пример ${index + 1}: ${image.alt}`} aria-current="false"></button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="gifts-categories" id="vazmozhnosti" aria-labelledby="categories-title">
      <div class="gifts-shell">
        <div class="gifts-section-heading">
          <p class="section-label">Възможности</p>
          <h2 id="categories-title">Избираме формата според повода</h2>
        </div>
        <ol class="gifts-categories__list">
          {categories.map(([name, copy], index) => (
            <li>
              <span>0{index + 1}</span>
              <h3>{name}</h3>
              <p>{copy}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <CataloguesSection
      items={catalogues}
      intro="Актуалните каталози на ВАМО – облекло за брандиране от Malfini и календарната кампания за 2027 г. Отварят се в нов раздел за преглед или сваляне."
      note="Искате печатна версия или подборка за конкретна кампания?"
      noteHref="#zapitvane"
      noteLabel="Пишете ни"
    />

    <section class="gifts-promo" aria-labelledby="promo-title">
      <div class="gifts-shell gifts-promo__inner">
        <h2 id="promo-title">Готови ли сте за своята кампания 2026?</h2>
        <p class="gifts-promo__lead">Подгответе се за празниците със стил, внимание и персонален подход.</p>
        <p class="gifts-promo__body">Рекламата днес не е въпрос на бюджет, а на емоция. Клиентите купуват, когато се разпознаят във вашата история. Екипът на ВАМО превръща вашето послание в преживяване — с филми, видеа, Reels и бранд визия, която остава в съзнанието.</p>
        <Button href="#zapitvane" size="lg" class="gifts-promo__cta">
          <PromoBadge>Промоция</PromoBadge>
          Поръчайте своя рекламен комплект
        </Button>
      </div>
    </section>

    <section class="gifts-trends" aria-labelledby="trends-title">
      <div class="gifts-shell gifts-trends__inner">
        <div class="gifts-trends__copy">
          <h2 id="trends-title">Новите тенденции за <span>2026/2027</span></h2>
          <p class="gifts-trends__lead">Еко, персонализирано, устойчиво.</p>
          <p class="gifts-trends__body">През 2026 г. рекламните продукти не са просто подаръци – <strong>те са послание</strong>. Изберете <strong>модерни решения</strong>, които показват вашата социална отговорност и отношение към природата:</p>
          <ul class="gifts-trends__list">
            <li><i class="ph ph-leaf" aria-hidden="true"></i><span>Продукти от <strong>рециклирани и биоразградими</strong> материали</span></li>
            <li><i class="ph ph-pen-nib" aria-hidden="true"></i><span><strong>Персонализирани комплекти</strong> с гравиране или ситопечат</span></li>
            <li><i class="ph ph-calendar-blank" aria-hidden="true"></i><span>Бизнес календари с <strong>фирмено лого и корпоративен стил</strong></span></li>
            <li><i class="ph ph-gift" aria-hidden="true"></i><span><strong>Стилни комплекти</strong> за офиси, събития и клиенти</span></li>
          </ul>
          <p class="gifts-trends__note">
            <CheckMark />
            <span><strong>Директен внос от европейски склад</strong> – <span>новите рекламни тенденции 2026 – 2027</span></span>
          </p>
        </div>

        <div class="gifts-trends__video">
          <iframe
            src="https://www.canva.com/design/DAG1qhH26Fs/wouOVZEoTKQXcpiWODQmzg/watch?embed"
            title="Видео с Мирослав Иванов, представител на Stricker"
            loading="lazy"
            allow="fullscreen; autoplay; encrypted-media"
          ></iframe>
        </div>
      </div>
    </section>

    <section class="gifts-gallery" aria-labelledby="gallery-title">
      <div class="gifts-shell">
        <div class="gifts-section-heading gifts-section-heading--light">
          <p class="section-label">Примери от нашата среда</p>
          <h2 id="gallery-title">Материали, които могат да бъдат полезни и красиви</h2>
        </div>
        <ul class="gifts-gallery__grid">
          {galleryImages.map((image) => (
            <li>
              <Image
                src={image.src}
                alt={image.alt}
                widths={[320, 640, 960, 1200]}
                sizes="(min-width: 64rem) 33vw, (min-width: 48rem) 50vw, 100vw"
                loading="lazy"
              />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="gifts-process" aria-labelledby="process-title">
      <div class="gifts-shell">
        <div class="gifts-process__heading">
          <p class="section-label">Как работим</p>
          <h2 id="process-title">Подаръкът започва с правилния въпрос</h2>
          <p class="gifts-process__lead">Работим по ясен процес, който започва с вашата цел и завършва с готов за употреба комплект.</p>
        </div>
        <ol class="gifts-process__list">
          {process.map(([number, title, copy]) => (
            <li>
              <span class="gifts-process__number">{number}</span>
              <h3>{title}</h3>
              <p>{copy}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="gifts-partners" aria-labelledby="partners-title">
      <div class="gifts-shell">
        <div class="gifts-partners__heading">
          <p class="section-label">Нашите партньори</p>
          <h2 id="partners-title">Работим с водещи европейски и български производители</h2>
        </div>
        <ul class="gifts-partners__list">
          {partners.map((partner) => (
            <li>
              <span class="gifts-partners__logo">
                <img src={partner.logo.src} alt={partner.alt} width={partner.logo.width} height={partner.logo.height} loading="lazy" />
              </span>
              <h3>{partner.name}</h3>
              <p>{partner.copy}</p>
            </li>
          ))}
        </ul>
        <ul class="gifts-partners__other">
          <li><strong>Voodoo Advertising</strong> – креативни рекламни решения</li>
          <li><strong>MAX PEN</strong>, Noex, FormTex, Office1, ЕТ „Влади-Веселин Влаев“</li>
        </ul>
        <p class="gifts-partners__note">Работим директно с вносители, за да гарантираме бързи срокове и преференциални цени.</p>
      </div>
    </section>

    <section class="gifts-inquiry" aria-labelledby="inquiry-title">
      <div class="gifts-shell gifts-inquiry__inner">
        <div class="gifts-inquiry__copy">
          <p class="section-label">Нека обсъдим вашия повод</p>
