  <script>
    document.querySelectorAll('[data-gifts-slider]').forEach((slider) => {
      const track = slider.querySelector('[data-gifts-track]');
      const prev = slider.querySelector<HTMLButtonElement>('[data-gifts-prev]');
      const next = slider.querySelector<HTMLButtonElement>('[data-gifts-next]');
      const dots = [...slider.querySelectorAll<HTMLButtonElement>('[data-gifts-dot]')];
      if (!track || !prev || !next || !dots.length) return;

      const slides = [...track.children] as HTMLElement[];
      if (slides.length < 2) return;

      const offsetOf = (index: number) => slides[index].offsetLeft - slides[0].offsetLeft;
      const currentIndex = () =>
        slides.reduce(
          (best, _slide, index) =>
            Math.abs(offsetOf(index) - track.scrollLeft) < Math.abs(offsetOf(best) - track.scrollLeft)
              ? index
              : best,
          0,
        );
      const goTo = (index: number) => {
        const target = Math.min(Math.max(index, 0), slides.length - 1);
        track.scrollTo({
          left: offsetOf(target),
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        });
      };
      const sync = () => {
        const index = currentIndex();
        prev.disabled = index === 0;
        next.disabled = index === slides.length - 1;
        dots.forEach((dot, dotIndex) => dot.setAttribute('aria-current', String(dotIndex === index)));
      };

      prev.addEventListener('click', () => goTo(currentIndex() - 1));
      next.addEventListener('click', () => goTo(currentIndex() + 1));
      dots.forEach((dot, index) => dot.addEventListener('click', () => goTo(index)));
      track.addEventListener('scroll', () => window.requestAnimationFrame(sync), { passive: true });

      slider.setAttribute('data-enhanced', '');
      sync();
    });
  </script>
</BaseLayout>

